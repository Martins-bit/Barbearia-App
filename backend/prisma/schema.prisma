generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  CLIENTE
  BARBEIRO
}

enum StatusAgendamento {
  CONFIRMADO
  CANCELADO
  CONCLUIDO
  NAO_COMPARECEU
}

enum StatusListaEspera {
  ATIVA
  NOTIFICADA
  ATENDIDA
  CANCELADA
  EXPIRADA
}

enum StatusWaitlistClaim {
  ATIVO
  EXPIRADO
  ACEITO
  RECUSADO
}

enum StatusWaitlistReoffer {
  PENDENTE
  PROCESSANDO
  CONCLUIDA
  FALHA_FINAL
}

enum OrigemWaitlistReoffer {
  CLAIM_RECUSADO
  ENTRADA_CANCELADA
  CLAIM_EXPIRADO
  AGENDAMENTO_CANCELADO
  BLOQUEIO_REMOVIDO
}

enum ResultadoWaitlistReoffer {
  CLAIM_CRIADO
  SEM_CANDIDATO
  FALHA_PERMANENTE
}

enum TipoNotificacao {
  WAITLIST_OPPORTUNITY
  AGENDAMENTO
  CANCELAMENTO
  LEMBRETE
  LISTA_ESPERA
  EMERGENCIA
  AVISO
  ALTERACAO_HORARIO
}

enum StatusEmergencia {
  ATIVA
  ENCERRADA
  CANCELADA
}

model Usuario {
  id              Int         @id @default(autoincrement())
  nome            String
  telefone        String      @unique
  email           String?     @unique
  emailVerificadoEm DateTime?
  senhaHash       String
  authVersion     Int         @default(0)
  tipoUsuario     TipoUsuario
  ativo           Boolean     @default(true)
  dataCriacao     DateTime    @default(now())
  dataAtualizacao DateTime    @updatedAt

  cliente            Cliente?
  barbeiro           Barbeiro?
  tokensConfirmacaoEmail EmailVerificationToken[]
  tokensRedefinicaoSenha PasswordResetToken[]
  notificacoes       Notificacao[]
  mensagensEnviadas  Mensagem[]    @relation("MensagensEnviadas")
  mensagensRecebidas Mensagem[]    @relation("MensagensRecebidas")
}

model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  usuarioId  Int
  email      String
  tokenHash  String    @unique @db.Char(64)
  criadoEm   DateTime  @default(now())
  expiraEm   DateTime
  usadoEm    DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([usuarioId, criadoEm])
  @@index([expiraEm])
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  usuarioId  Int
  email      String
  tokenHash  String    @unique @db.Char(64)
  criadoEm   DateTime  @default(now())
  expiraEm   DateTime
  usadoEm    DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([usuarioId, criadoEm])
  @@index([expiraEm])
}

model PasswordResetRateLimit {
  identifierHash  String   @id @db.Char(64)
  windowStartedAt DateTime
  attemptCount    Int
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
}

model Cliente {
  id              Int      @id @default(autoincrement())
  usuarioId       Int      @unique
  dataCriacao     DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  usuario      Usuario       @relation(fields: [usuarioId], references: [id])
  agendamentos Agendamento[]
  listaEspera  ListaEspera[]
}

model Barbeiro {
  id              Int      @id @default(autoincrement())
  usuarioId       Int      @unique
  ativo           Boolean  @default(true)
  dataCriacao     DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  usuario      Usuario                @relation(fields: [usuarioId], references: [id])
  servicos     Servico[]
  agendamentos Agendamento[]
  horarios     HorarioFuncionamento[]
  bloqueios    BloqueioAgenda[]
  emergencias  Emergencia[]
  listaEspera  ListaEspera[]
}

model Servico {
  id              Int      @id @default(autoincrement())
  barbeiroId      Int
  nome            String
  descricao       String?
  duracaoMinutos  Int
  preco           Decimal  @db.Decimal(10, 2)
  ativo           Boolean  @default(true)
  dataCriacao     DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  barbeiro     Barbeiro      @relation(fields: [barbeiroId], references: [id])
  agendamentos Agendamento[]
  listaEspera  ListaEspera[]

  @@index([barbeiroId])
  @@index([ativo])
}

model Agendamento {
  id              Int               @id @default(autoincrement())
  clienteId       Int
  barbeiroId      Int
  servicoId       Int
  data            DateTime          @db.Date
  horaInicio      DateTime
  horaFim         DateTime
  status          StatusAgendamento @default(CONFIRMADO)
  observacoes     String?
  dataCriacao     DateTime          @default(now())
  dataAtualizacao DateTime          @updatedAt

  cliente  Cliente  @relation(fields: [clienteId], references: [id])
  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id])
  servico  Servico  @relation(fields: [servicoId], references: [id])
  notificacoes Notificacao[]

  @@index([clienteId])
  @@index([barbeiroId, data])
  @@index([servicoId])
  @@index([status])
}

model ListaEspera {
  id              Int               @id @default(autoincrement())
  clienteId       Int
  barbeiroId      Int
  servicoId       Int
  dataDesejada    DateTime          @db.Date
  horaInicio      String?
  horaFim         String?
  status          StatusListaEspera @default(ATIVA)
  dataEntrada     DateTime          @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')"))
  dataAtualizacao DateTime          @updatedAt

  cliente  Cliente         @relation(fields: [clienteId], references: [id])
  barbeiro Barbeiro        @relation(fields: [barbeiroId], references: [id])
  servico  Servico         @relation(fields: [servicoId], references: [id])
  claims   WaitlistClaim[]

  @@index([clienteId])
  @@index([barbeiroId])
  @@index([servicoId, dataDesejada, status])
  @@index([clienteId, barbeiroId, servicoId, dataDesejada, status])
}

model WaitlistClaim {
  id              Int                 @id @default(autoincrement())
  listaEsperaId   Int
  barbeiroId      Int
  servicoId       Int
  data            DateTime            @db.Date
  horaInicio      String
  horaFim         String
  status          StatusWaitlistClaim @default(ATIVO)
  expiraEm        DateTime
  reofertaOutboxId Int?                @unique
  dataCriacao     DateTime            @default(now())
  dataAtualizacao DateTime            @updatedAt

  listaEspera    ListaEspera             @relation(fields: [listaEsperaId], references: [id])
  reofertaOutbox WaitlistReofferOutbox? @relation(fields: [reofertaOutboxId], references: [id], onDelete: Restrict)
  notificacoes Notificacao[]

  @@index([barbeiroId, servicoId, data, horaInicio, horaFim, status])
  @@index([listaEsperaId, status])
  @@index([expiraEm])
}

model WaitlistReofferOutbox {
  id                 Int                      @id @default(autoincrement())
  chaveIdempotencia  String                   @unique
  origem             OrigemWaitlistReoffer
  origemId           Int?
  barbeiroId         Int
  data               DateTime                 @db.Date
  horaInicio         String
  horaFim            String
  status             StatusWaitlistReoffer    @default(PENDENTE)
  tentativas         Int                      @default(0)
  proximaTentativaEm DateTime                 @default(now())
  leaseAte           DateTime?
  ultimoErro         String?                  @db.Text
  resultado          ResultadoWaitlistReoffer?
  concluidoEm        DateTime?
  dataCriacao        DateTime                 @default(now())
  dataAtualizacao    DateTime                 @updatedAt

  claim WaitlistClaim?

  @@index([status, proximaTentativaEm, id])
  @@index([status, leaseAte])
  @@index([origem, origemId])
}

model Notificacao {
  id            Int             @id @default(autoincrement())
  usuarioId     Int
  claimId       Int?
  agendamentoId Int?
  tipo          TipoNotificacao
  titulo        String
  mensagem      String
  lida          Boolean         @default(false)
  limpa         Boolean         @default(false)
  dataCriacao   DateTime        @default(now())
  dataLeitura   DateTime?

  usuario     Usuario        @relation(fields: [usuarioId], references: [id])
  claim       WaitlistClaim? @relation(fields: [claimId], references: [id])
  agendamento Agendamento?   @relation(fields: [agendamentoId], references: [id])

  @@index([usuarioId, lida])
  @@index([usuarioId, dataCriacao])
  @@index([usuarioId, limpa])
  @@index([claimId])
  @@index([agendamentoId])
}

model Mensagem {
  id                       Int       @id @default(autoincrement())
  remetenteId              Int
  destinatarioId           Int
  conteudo                 String
  lida                     Boolean   @default(false)
  dataCriacao              DateTime  @default(now())
  dataLeitura              DateTime?
  apagadaParaTodos         Boolean   @default(false)
  excluidaPeloRemetente    Boolean   @default(false)
  excluidaPeloDestinatario Boolean   @default(false)
  dataExclusao             DateTime?

  remetente    Usuario @relation("MensagensEnviadas", fields: [remetenteId], references: [id])
  destinatario Usuario @relation("MensagensRecebidas", fields: [destinatarioId], references: [id])

  @@index([remetenteId])
  @@index([destinatarioId, lida])
  @@index([destinatarioId, dataCriacao])
  @@index([remetenteId, destinatarioId, dataCriacao])
  @@index([destinatarioId, remetenteId, dataCriacao])
}

model HorarioFuncionamento {
  id         Int     @id @default(autoincrement())
  barbeiroId Int
  diaSemana  Int
  horaInicio String
  horaFim    String
  ativo      Boolean @default(true)

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id])

  @@index([barbeiroId, diaSemana])
}

model BloqueioAgenda {
  id          Int      @id @default(autoincrement())
  barbeiroId  Int
  data        DateTime @db.Date
  horaInicio  DateTime
  horaFim     DateTime
  motivo      String?
  ativo       Boolean  @default(true)
  dataCriacao DateTime @default(now())

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id])

  @@index([barbeiroId, data])
}

model Emergencia {
  id          Int              @id @default(autoincrement())
  barbeiroId  Int
  dataInicio  DateTime
  dataFim     DateTime
  motivo      String
  status      StatusEmergencia @default(ATIVA)
  dataCriacao DateTime         @default(now())

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id])

  @@index([barbeiroId, dataInicio, dataFim])
}
